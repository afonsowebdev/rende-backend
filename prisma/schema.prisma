// =========================================================
//  Rende+ — Esquema completo da base de dados (Prisma)
// =========================================================
//  Cada "model" é uma tabela. Os dados (despesas, rendimentos,
//  metas, contas, categorias) pertencem todos a um utilizador
//  (campo userId). Os aforros pertencem a uma meta, que por sua
//  vez pertence a um utilizador.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Utilizadores (contas) ----
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String?      // guardada CIFRADA (hash) — definida só DEPOIS de confirmar o email
  nome        String?
  moeda       String       @default("EUR")
  poupancaPct Int          @default(20) // 10 a 50
  orcamento   Float        @default(0)
  // ---- Perfil do onboarding (passo 3) ----
  //  Estes campos guardam as escolhas que o utilizador faz ao criar a conta.
  //  São opcionais (?) porque contas antigas não os têm. As listas usam o
  //  tipo String[] (lista de texto), suportado pelo PostgreSQL.
  pais            String?    // código do país de residência (ex.: "PT")
  telefone        String?    // opcional
  preferencia     String?    // "controlar" | "poupar" | "investir"
  sobre           String?    // texto livre sobre os objetivos (opcional)
  situacao        String?    // "estudante" | "trabalhador" | ...
  objetivo        String?    // "fundo" | "casa" | "viajar" | ...
  planeamento     String?    // "sim" | "ainda-nao" | "comecar"
  partilha        String?    // "nao" | "parceiro" | "casa" | "familia"
  fontesRendimento   String[] @default([]) // ex.: ["Salário", "Bolsa"]
  principaisDespesas String[] @default([]) // ex.: ["Renda", "Alimentação"]
  notificacoes    Boolean    @default(true)
  resumoSemanal   Boolean    @default(true)
  // ---- Permissões (separado do plano — plano é o nível de subscrição,
  //  role é quem pode aceder ao painel de administração). Nunca deve ser
  //  definido a "admin" por nenhum fluxo de auto-registo — só manualmente
  //  na base de dados (ver README do painel admin).
  role             String    @default("user") // "user" | "admin"
  // ---- Plano / subscrição ----
  //  O premium não é outro sistema: é a mesma conta com um "nível".
  //  "free" por defeito; passa a "premium" quando houver um pagamento ativo.
  plano            String    @default("free") // "free" | "premium"
  planoExpira      DateTime?  // até quando o premium é válido (null = sem premium ativo)
  stripeCustomerId String?   @unique // id do cliente no Stripe (criado no 1.º pagamento)
  stripeSubId      String?   // id da subscrição ativa no Stripe (para gerir renovações/cancelamentos)
  emailVerificado Boolean  @default(false) // o email foi confirmado por código?
  codigoVerif String?      // hash (bcrypt) do código de 6 dígitos enviado por email
  codigoExpira DateTime?   // até quando o código é válido
  // ---- Recuperação de palavra-passe (código enviado por email) ----
  codigoReset      String?    // hash (bcrypt) do código de recuperação
  codigoResetExpira DateTime? // até quando o código de recuperação é válido
  // ---- Data de nascimento (bloqueia 7 dias depois de ser definida) ----
  dataNascimento      String?   // formato AAAA-MM-DD
  nascimentoDefinidoEm DateTime? // quando foi definida pela 1.ª vez (conta os 7 dias a partir daqui)
  // ---- Sessão / atividade (painel de administração) ----
  //  sessaoInvalidadaEm: quando um admin força o logout desta conta. Os tokens
  //  JWT não têm blacklist própria — em vez disso, exigirLogin compara o "iat"
  //  (data de emissão) do token com esta data; qualquer token emitido antes
  //  passa a ser recusado. null = nunca foi forçado nenhum logout.
  sessaoInvalidadaEm DateTime?
  //  ultimoLogin: preenchido em POST /api/auth/login a cada início de sessão
  //  bem-sucedido. Campo novo (não existia antes) — contas que nunca fizerem
  //  login a partir de agora ficam com null.
  ultimoLogin        DateTime?
  createdAt   DateTime     @default(now())
  despesas    Despesa[]
  rendimentos Rendimento[]
  metas       Meta[]
  contas      Conta[]
  categorias  Categoria[]
  lembretes   Lembrete[]
  // ---- Assistente Financeiro (IA) ----
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]
  assistantUsage         AssistantUsage[]
  assistantFeedback      AssistantFeedback[]
  // ---- Painel de administração ----
  adminAuditLogs AdminAuditLog[] // ações que este utilizador fez enquanto admin
  // ---- Partilha (grupos partilhados, Premium) ----
  gruposCriados    Grupo[]        @relation("GrupoCriador")
  gruposMembro     GrupoMembro[]
  convitesRecebidos GrupoConvite[] @relation("ConviteConvidado")
  convitesEnviados  GrupoConvite[] @relation("ConviteConvidante")
}

// ---- Lembretes (Premium): pagamentos a não esquecer ----
model Lembrete {
  id        String   @id @default(cuid())
  titulo    String
  valor     Float    @default(0)
  data      String   // data do pagamento, formato AAAA-MM-DD
  repete    Boolean  @default(false) // repete todos os meses?
  aviso     Int      @default(3)     // quantos dias antes avisar
  cat       String?  // categoria (opcional)
  pago      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- Despesas ----
model Despesa {
  id        String   @id @default(cuid())
  nome      String
  cat       String   @default("outros")
  valor     Float
  data      String
  tipo      String   @default("variavel")
  origem    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ---- Rendimentos ----
model Rendimento {
  id        String   @id @default(cuid())
  fonte     String
  cat       String   @default("Outros")
  valor     Float
  data      String
  rec       Boolean  @default(false)
  origem    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ---- Metas de poupança ----
model Meta {
  id        String   @id @default(cuid())
  nome      String
  alvo      Float    @default(0)
  atual     Float    @default(0)
  aforros   Aforro[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ---- Aforros (depósitos numa meta) ----
model Aforro {
  id        String   @id @default(cuid())
  valor     Float
  data      String
  meta      Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
  metaId    String
  createdAt DateTime @default(now())
}

// ---- Contas ligadas ----
model Conta {
  id             String   @id @default(cuid())
  banco          String
  nome           String
  saldo          Float    @default(0)
  moeda          String   @default("EUR")
  ligadoEm       String?
  sincronizadoEm String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
}

// ---- Categorias personalizadas ----
model Categoria {
  id        String   @id @default(cuid())
  nome      String
  cor       String?
  icon      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// =========================================================
//  Assistente Financeiro (IA) — preparação de infraestrutura
// ---------------------------------------------------------
//  Estas tabelas ainda não guardam respostas reais de IA:
//  nenhum fornecedor está ligado nesta fase. Servem só para o
//  histórico de conversas, o registo de utilização (limites por
//  plano) e o feedback do utilizador, todos isolados por userId.
// =========================================================

// ---- Conversas do assistente ----
model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String
  titulo    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensagens AssistantMessage[]

  @@index([userId])
}

// ---- Mensagens de cada conversa (utilizador e assistente) ----
model AssistantMessage {
  id     String @id @default(cuid())
  conversationId String
  userId String
  role   String // "user" | "assistant" | "system"
  content String // texto da mensagem (pergunta ou resposta em bruto)
  // Resposta já validada e estruturada (ver assistant-response.service).
  // Fica a null enquanto não existir fornecedor de IA ligado.
  structuredResponse Json?
  createdAt DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback     AssistantFeedback[]

  @@index([conversationId])
  @@index([userId])
}

// ---- Utilização por utilizador e por período (para limites do plano) ----
model AssistantUsage {
  id            String    @id @default(cuid())
  userId        String
  period        String    // formato "AAAA-MM"
  requestCount  Int       @default(0)
  // Colunas preparadas para quando existir fornecedor de IA (ainda não usadas).
  inputTokens   Int?      @default(0)
  outputTokens  Int?      @default(0)
  estimatedCost Float?    @default(0)
  lastRequestAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

// ---- Feedback do utilizador a uma resposta do assistente ----
model AssistantFeedback {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  rating    Int?     // ex.: 1 a 5, ou null se só houver comentário
  comment   String?
  createdAt DateTime @default(now())

  message AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
}

// =========================================================
//  Painel de administração
// ---------------------------------------------------------
//  Regista todas as ações feitas por administradores (ex.: mudar
//  o plano de um utilizador manualmente), para haver sempre um
//  histórico de quem fez o quê. adminId é opcional e o apagar do
//  admin não apaga o registo (onDelete: SetNull) — o histórico
//  tem de sobreviver mesmo que a conta do admin deixe de existir.
// =========================================================
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String? // quem fez a ação (fica null se essa conta for apagada — o registo mantém-se)
  acao       String   // ex.: "mudar_plano"
  alvoUserId String   // id do utilizador afetado (texto simples, sem relação — sobrevive mesmo que esse utilizador seja apagado)
  detalhes   String   // JSON em texto com o que mudou (ex.: {"de":"free","para":"premium"})
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([alvoUserId])
}

// ---- Anúncios/avisos dentro da app (banner no dashboard normal) ----
//  Só um costuma estar ativo de cada vez (o mais recente com ativo=true é o
//  que aparece no banner — ver GET /api/anuncios/ativo), mas o campo não tem
//  restrição de unicidade: o admin pode desativar/reativar livremente.
model Anuncio {
  id              String   @id @default(cuid())
  titulo          String
  mensagem        String
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  criadoPorAdminId String? // quem criou (fica null se essa conta de admin for apagada)
}

// ---- Erros do sistema (capturados pelo tratador de erros central do
//  servidor — ver server.js) — resumo apenas: mensagem, stack (opcional),
//  rota e data. De propósito SEM dados do pedido (body/query/headers),
//  para nunca guardar dados sensíveis de utilizadores nos logs. ----
model ErroSistema {
  id        String   @id @default(cuid())
  mensagem  String
  stack     String?
  rota      String
  criadoEm  DateTime @default(now())
}

// =========================================================
//  Partilha (grupos partilhados) — Fase 1: só grupos, membros
//  e convites REAIS (com email a sério). Despesas partilhadas,
//  saldos e chat de grupo continuam simulados no frontend
//  (localStorage) por agora — ver premium.jsx — e ficam para
//  uma fase seguinte, fora do âmbito desta primeira versão.
// ---------------------------------------------------------
//  Só quem já tem conta Rende+ pode ser convidado (decisão
//  explícita): por isso convidadoId é sempre uma relação real a
//  um User, nunca só um email solto. Tanto quem cria o grupo
//  como quem aceita o convite têm de ser Premium — verificado
//  sempre no backend (routes/grupos.js), nunca só no frontend.
// =========================================================
model Grupo {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  criadoPorId String
  createdAt   DateTime @default(now())

  criadoPor User          @relation("GrupoCriador", fields: [criadoPorId], references: [id], onDelete: Cascade)
  membros   GrupoMembro[]
  convites  GrupoConvite[]

  @@index([criadoPorId])
}

// ---- Membros reais de um grupo (o criador entra logo como "owner") ----
model GrupoMembro {
  id        String   @id @default(cuid())
  grupoId   String
  userId    String
  papel     String   @default("membro") // "owner" | "membro"
  entradaEm DateTime @default(now())

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([grupoId, userId])
  @@index([userId])
}

// ---- Convites para entrar num grupo (por email, sempre a um User já existente) ----
model GrupoConvite {
  id             String    @id @default(cuid())
  grupoId        String
  convidadoId    String    // User convidado (tem de já ter conta)
  convidadoPorId String    // User que enviou o convite
  estado         String    @default("pendente") // "pendente" | "aceite" | "recusado"
  criadoEm       DateTime  @default(now())
  respondidoEm   DateTime?

  grupo      Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  convidado  User  @relation("ConviteConvidado", fields: [convidadoId], references: [id], onDelete: Cascade)
  convidante User  @relation("ConviteConvidante", fields: [convidadoPorId], references: [id], onDelete: Cascade)

  @@index([grupoId])
  @@index([convidadoId])
}
