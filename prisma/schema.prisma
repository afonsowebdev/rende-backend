// =========================================================
//  Rende+ — Esquema completo da base de dados (Prisma)
// =========================================================
//  Cada "model" é uma tabela. Os dados (despesas, rendimentos,
//  metas, contas, categorias) pertencem todos a um utilizador
//  (campo userId). Os aforros pertencem a uma meta, que por sua
//  vez pertence a um utilizador.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Utilizadores (contas) ----
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String?      // guardada CIFRADA (hash) — definida só DEPOIS de confirmar o email
  nome        String?
  moeda       String       @default("EUR")
  poupancaPct Int          @default(20) // 10 a 50
  orcamento   Float        @default(0)
  // ---- Perfil do onboarding (passo 3) ----
  //  Estes campos guardam as escolhas que o utilizador faz ao criar a conta.
  //  São opcionais (?) porque contas antigas não os têm. As listas usam o
  //  tipo String[] (lista de texto), suportado pelo PostgreSQL.
  pais            String?    // código do país de residência (ex.: "PT")
  telefone        String?    // opcional
  preferencia     String?    // "controlar" | "poupar" | "investir"
  sobre           String?    // texto livre sobre os objetivos (opcional)
  situacao        String?    // "estudante" | "trabalhador" | ...
  objetivo        String?    // "fundo" | "casa" | "viajar" | ...
  planeamento     String?    // "sim" | "ainda-nao" | "comecar"
  partilha        String?    // "nao" | "parceiro" | "casa" | "familia"
  fontesRendimento   String[] @default([]) // ex.: ["Salário", "Bolsa"]
  principaisDespesas String[] @default([]) // ex.: ["Renda", "Alimentação"]
  notificacoes    Boolean    @default(true)
  resumoSemanal   Boolean    @default(true)
  // ---- Plano / subscrição ----
  //  O premium não é outro sistema: é a mesma conta com um "nível".
  //  "free" por defeito; passa a "premium" quando houver um pagamento ativo.
  plano            String    @default("free") // "free" | "premium"
  planoExpira      DateTime?  // até quando o premium é válido (null = sem premium ativo)
  stripeCustomerId String?   @unique // id do cliente no Stripe (criado no 1.º pagamento)
  stripeSubId      String?   // id da subscrição ativa no Stripe (para gerir renovações/cancelamentos)
  emailVerificado Boolean  @default(false) // o email foi confirmado por código?
  codigoVerif String?      // hash (bcrypt) do código de 6 dígitos enviado por email
  codigoExpira DateTime?   // até quando o código é válido
  // ---- Recuperação de palavra-passe (código enviado por email) ----
  codigoReset      String?    // hash (bcrypt) do código de recuperação
  codigoResetExpira DateTime? // até quando o código de recuperação é válido
  // ---- Data de nascimento (bloqueia 7 dias depois de ser definida) ----
  dataNascimento      String?   // formato AAAA-MM-DD
  nascimentoDefinidoEm DateTime? // quando foi definida pela 1.ª vez (conta os 7 dias a partir daqui)
  createdAt   DateTime     @default(now())
  despesas    Despesa[]
  rendimentos Rendimento[]
  metas       Meta[]
  contas      Conta[]
  categorias  Categoria[]
  lembretes   Lembrete[]
}

// ---- Lembretes (Premium): pagamentos a não esquecer ----
model Lembrete {
  id        String   @id @default(cuid())
  titulo    String
  valor     Float    @default(0)
  data      String   // data do pagamento, formato AAAA-MM-DD
  repete    Boolean  @default(false) // repete todos os meses?
  aviso     Int      @default(3)     // quantos dias antes avisar
  cat       String?  // categoria (opcional)
  pago      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- Despesas ----
model Despesa {
  id        String   @id @default(cuid())
  nome      String
  cat       String   @default("outros")
  valor     Float
  data      String
  tipo      String   @default("variavel")
  origem    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ---- Rendimentos ----
model Rendimento {
  id        String   @id @default(cuid())
  fonte     String
  cat       String   @default("Outros")
  valor     Float
  data      String
  rec       Boolean  @default(false)
  origem    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ---- Metas de poupança ----
model Meta {
  id        String   @id @default(cuid())
  nome      String
  alvo      Float    @default(0)
  atual     Float    @default(0)
  aforros   Aforro[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// ---- Aforros (depósitos numa meta) ----
model Aforro {
  id        String   @id @default(cuid())
  valor     Float
  data      String
  meta      Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
  metaId    String
  createdAt DateTime @default(now())
}

// ---- Contas ligadas ----
model Conta {
  id             String   @id @default(cuid())
  banco          String
  nome           String
  saldo          Float    @default(0)
  moeda          String   @default("EUR")
  ligadoEm       String?
  sincronizadoEm String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
}

// ---- Categorias personalizadas ----
model Categoria {
  id        String   @id @default(cuid())
  nome      String
  cor       String?
  icon      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
