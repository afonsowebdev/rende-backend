# Porta onde o servidor corre localmente
PORT=3000

# Ligação à base de dados do Neon (a string DIRETA, sem -pooler).
DATABASE_URL=""

# Segredo que assina as fichas de acesso (tokens).
# Mete aqui um texto longo e aleatório. Gera um com este comando no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ---- Envio de email (verificação de conta) ----
# Funciona com qualquer SMTP: Brevo, Gmail (palavra-passe de app), Mailgun, etc.
# Se deixares isto vazio, o servidor mostra o código na consola (modo de teste).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Remetente que aparece no email. Usa um endereço do teu domínio rendemais.pt.
MAIL_FROM="Rende+ <nao-responder@rendemais.pt>"

# ---- Rita — Assistente IA do Rende+ (Anthropic/Claude) ----
# Nunca colocar a chave real neste ficheiro (é o .example) — só no .env local
# e nas variáveis de ambiente do servidor (Render).
AI_PROVIDER="anthropic"
AI_API_KEY=""
# Alias oficial da Anthropic para o Claude Haiku 4.5 (resolve para o
# snapshot fixo claude-haiku-4-5-20251001).
AI_MODEL="claude-haiku-4-5"
AI_TIMEOUT_MS="30000"
AI_MAX_TOKENS="1024"
